  "proxy": {"enabled": false, "profile": "direct"},
  "runtime": {"max_workers_default": 2, "retry_delay_min_sec": 20, "retry_delay_max_sec": 60, "proxy_retry_delay_min_sec": 10, "proxy_retry_delay_max_sec": 30}
